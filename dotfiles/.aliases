#yarn
alias yu='yarn upgrade-interactive'
alias yi='yarn install'
alias ya='yarn add'
alias yad='yarn add --dev'
alias yr='yarn remove'

alias yss='yarn start'
alias yas='yarn start'
alias yrd='yarn run dev'
alias yd='yarn run dev'
alias yass='yarn starts'
alias yaw='yarn run watch'
alias ysm='yarn start:mocks'
alias ytw='yarn test:watch'
alias ytc='yarn test:coverage'
alias ytus='yarn test:updatesnapshots'

#npm
alias nps='npm start'
alias npd='npm run dev'
alias npt='npm run test'
alias ntw='npm run test:watch'
alias ntwa='npm run test:watchAll'
alias ntc='npm run test:coverage'
alias ntus='npm run test:updatesnapshots'
alias npch='npm run check-types && npm run lint:css:fix && npm run lint:js:fix'
alias npchall='npm run check-types && npm run lint:css:fix && npm run lint:js:fix && npm run prod:fe && npm run test:coverage'

#pnpm
alias pcc='pnpm run lint && pnpm run ts && pnpm run test'
alias pcu='pnpm run lint && pnpm run ts && pnpm run test:update'

# ----------------------

# Git Aliases

# ----------------------

alias ga='git add'
alias gaa='git add .'
alias gaaa='git add --all'
alias gau='git add --update'
alias gb='git branch'
alias gbd='git branch --delete '
alias gbD='git branch -D '
alias gbDd='git branch -D develop'
alias gbDm='git branch -D master'
alias gc='git commit'
alias gcm='git commit --message'
alias gcf='git commit --fixup'
alias gco='git checkout'
alias gcob='git checkout -b'
alias gcam='git commit -am'
alias gchp='git cherry-pick'
alias gcom='git checkout main'
alias gcos='git checkout staging'
alias gcod='git checkout develop'
alias gcodd='git checkout dev'
alias gd='git diff'
alias gda='git diff HEAD'
alias gi='git init'
alias glg='git log --graph --oneline --decorate --all'
alias glo='git log --pretty=oneline'
alias gld='git log --pretty=format:'%h %ad %s' --date=short --all'
alias gf='git fetch'
alias gfCld='git fetch && git branch -D develop && git checkout develop'
alias gfClm='git fetch && git branch -D master && git checkout master'
alias gm='git merge --no-ff'
alias gma='git merge --abort'
alias gmc='git merge --continue'
alias gpl='git pull'
alias gpsh='git push'
alias gpshu='git push -u'
alias gpshuo='git push -u origin'
alias gpshuob='git push -u origin $glf'

alias gip='git pull'
alias gPo='git push origin '
alias gpr='git pull --rebase'
alias gr='git rebase'
alias grc='git rebase --continue'
alias gmom='git merge origin/master'
alias gmos='git merge origin/staging'
alias gmod='git merge origin/develop'
alias gmodd='git merge origin/dev'
alias grom='git rebase origin/master'
alias gros='git rebase origin/staging'
alias grod='git rebase origin/develop'
alias grodd='git rebase origin/development'
alias gmod='git merge origin/development'
alias gmodd='git merge origin/develop'
alias gs='git status'
alias gss='git status --short'
alias gst='git stash'
alias gsta='git stash apply'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gstp='git stash pop'
alias gsts='git stash save'

# hacks to show/hide hidden/dot files

alias showFiles='defaults write com.apple.finder AppleShowAllFiles YES; killall Finder'
alias hideFiles='defaults write com.apple.finder AppleShowAllFiles NO; killall Finder'

# find processes which run on custom port

alias findProcess='lsof -i'
alias killProcess='kill -9 '

alias exprt="export PORT=3015"
alias mongods="mongod --config /usr/local/etc/mongod.conf"

alias smongod='mongo --host 127.0.0.1:27017'
alias python='python3'

# AEM local instances (put author/publish jars under ~/aem-instances/AEM_6.5)
alias aemAuthor="cd ~/aem-instances/AEM_6.5/author && java -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=45012 -jar aem-author-p4502.jar -gui -nobrowser -verbose -nofork -r author,local -Dadmin.password=admin"
alias aemPublish="cd ~/aem-instances/AEM_6.5/publish && java -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=45013 -jar aem-publish-p4503.jar -gui -nobrowser -verbose -nofork -r publish,local,dynamicmedia_scene7 -Dadmin.password=admin"
# deploy the AEM project in the current directory
alias deployAuthor="mvn clean install -PautoInstallPackage -Dmaven.test.skip=true -PskipChecks"
alias deployPublish="mvn clean install -PautoInstallPackagePublish -Dmaven.test.skip=true -PskipChecks"
alias deployquick="mvn clean install -PautoInstallPackage -Dmaven.tests.skip=true -DskipChecks"
alias spotlessAem="mvn spotless:apply"

#============ MongoDB Services =============#
alias start-mongod="brew services start mongodb-community@5.0"
alias stop-mongod="brew services stop mongodb-community@5.0"

alias spotlessAem="mvn spotless:apply"

alias cleanupDocker="docker system prune -f"

alias nosleep="caffeinate"
