# main shortcuts

alias edit='open -a "BBEdit"'

# IP6-ON-OFF

alias ipv6off='networksetup -setv6off Wi-Fi'
alias ipv6on='networksetup -setv6automatic Wi-Fi'

# --- SSH --- ZSH --- BASH ---

alias sublime="subl"
alias editBash='vim ~/.bash_profile'
alias editZsh='vim ~/.zshrc'
alias reloadBash='source ~/.bash_profile'
alias reloadZsh='source ~/.zshrc'
alias reloadSSH='killall ssh-agent; eval `ssh-agent`'
alias reloadAll='source ~/.zshrc && echo \"zsh_reloaded\" && source ~/.bash_profile && echo \"bash_reloaded\" && reloadSSH'
alias myip='curl ifconfig.me'

alias editor="code"

alias edit-alias="editor ~/.aliases"
alias caliases="cd && editor .aliases .exports .zshrc .functions .path .bash_profile .bashrc"
alias edit-path="editor ~/.path"
alias edit-export="editor ~/.exports"
alias edit-functions="editor ~/.functions"
alias edit-zsh="editor ~/.zshrc"
alias edit-bash="editor ~/.bash_profile"
alias edit-ssh="editor ~/.ssh"
alias edit-sshc="editor ~/.ssh/config"

alias github-update-hosts="ssh-keygen -R github.com && curl -L https://api.github.com/meta | jq -r '.ssh_keys | .[]' | sed -e 's/^/github.com /' >> ~/.ssh/known_hosts"

alias bitbucket-update-hosts="ssh-keygen -R bitbucket.org && curl https://bitbucket.org/site/ssh >> ~/.ssh/known_hosts"

alias saliases="cd && editor .aliases .exports .zshrc .functions .path .bash_profile .bashrc"

alias chrome-no-security="open -n -a /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --args --user-data-dir='/tmp/chrome_dev_test' --disable-web-security"

alias node-cln="npm cache clean --force"

# -------

# Aliases

# -------

alias clr="clear" # Clear your terminal screen
alias flush="sudo discoveryutil udnsflushcaches" # Flush DNS (Yosemite)
alias flush="killall -HUP mDNSResponder" # Flush DNS (Mavericks, Mountain Lion, Lion)
alias flush="dscacheutil -flushcache" # Flush DNS (Snow Leopard, Leopard)
alias ip="curl icanhazip.com" # Your public IP address
alias ll="ls -al" # List all files in current directory in long list format
alias ldir="ls -al | grep ^d" # List all directories in current directory in long list format
alias o="open ." # Open the current directory in Finder
alias ut="uptime" # Computer uptime

# -------

# NPM Packages

# -------

alias ndep="npm publish --access=public"

# ------------

# ALL Projects

# ------------

# MyProjects

alias pp='cd ~/MyProjects'
alias prj='cd ~/MyProjects'
#================== aem-learning ==================#
alias lrn-aemAuthor="cd ~/aem-instances/AEM_6.5_Learning/author && java -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=45012 -jar aem-author-p4502.jar -gui -nobrowser -verbose -nofork -r author,local,dynamicmedia_scene7 -Dadmin.password=admin"
alias lrn-aemPublish="cd ~/aem-instances/AEM_6.5_Learning/publish && java -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=45013 -jar aem-publish-p4503.jar -gui -nobrowser -verbose -nofork -r publish,local,dynamicmedia -Dadmin.password=admin"

#aem-learning
alias lrn-aeml-auth="mvn clean install -PautoInstallPackage,adobe-public -Daem.port=4502 -DskipTests"
alias lrn-aeml-publ="mvn clean install -PautoInstallPackagePublish,adobe-public -Daem.port=4503 -DskipTests"
alias lrn-aeml-both="mvn clean install -PautoInstallPackage,autoInstallPackagePublish -DskipTests"

#=========================================================#

# quick AEM SYNC from inside the directories

alias aem-sync-auth="aemsync -t http://admin:admin@localhost:4502"
alias aem-sync-pub="aemsync -t http://admin:admin@localhost:4503"

alias aeml-auth="mvn clean install -PautoInstallPackage,adobe-public -Daem.port=4502 -DskipTests"
alias aeml-publ="mvn clean install -PautoInstallPackagePublish,adobe-public -Daem.port=4503 -DskipTests"
alias aeml-both="mvn clean install -PautoInstallPackage,autoInstallPackagePublish -DskipTests"

alias aemlcln="mvn clean && rm -rf node node_modules lib package-lock.json"

alias aeml-clpl="mvn clean && rm -rf ui.designs-react/node ui.designs-react/node_modules ui.designs-react/package-lock.json ui.designs-cc/node ui.designs-cc/node_modules ui.designs-cc/package-lock.json ui.apps/node ui.apps/node_modules ui.apps/package-lock.json ui.content/node ui.content/node_modules ui.content/package-lock.json ui.content/target"

alias aeml-cln="mvn clean && rm -rf ui.designs-cc/node ui.designs-cc/node_modules ui.designs-cc/package-lock.json ui.designs-react/node ui.designs-react/node_modules ui.designs-react/package-lock.json ui.designs/node ui.designs/node_modules ui.designs/package-lock.json ui.frontend/node ui.frontend/node_modules ui.frontend/package-lock.json"

alias aeml-cla="mvn clean && rm -rf ui.designs-cc/node ui.designs-cc/node_modules ui.designs-cc/package-lock.json ui.designs-react/node ui.designs-react/node_modules ui.designs-react/package-lock.json ui.designs/node ui.designs/node_modules ui.designs/package-lock.json ui.content/target ui.frontend/node ui.frontend/node_modules ui.frontend/package-lock.json"

alias aemlog-auth="sublime ~/aem-instances/AEM_6.5/author/crx-quickstart/logs/error.log"
alias aemlog-publ="sublime ~/aem-instances/AEM_6.5/publish/crx-quickstart/logs/error.log"

