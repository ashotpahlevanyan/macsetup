#!/bin/bash
#
# newmac — set up a fresh Mac the way I like it.
#
#   newmac init          ask the setup questions, then run every step
#   newmac configure     only (re)answer the questions
#   newmac <step> ...    run single steps, e.g. `newmac ssh iterm`
#   newmac steps         list the steps
#   newmac capture       copy this Mac's IntelliJ / iTerm2 / keyboard
#                        settings back into the repo
#   newmac update        git pull this repo, then `brew upgrade`
#
# Re-running is safe: every step checks what is already there.

# ─── Where things live ───────────────────────────────────────────────────────

# This repo, even when newmac is called through the ~/.local/bin symlink.
resolve_repo_dir() {
  local source=${BASH_SOURCE[0]} dir
  while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ $source == /* ]] || source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

NEWMAC_DIR=$(resolve_repo_dir)
NEWMAC_CONFIG_DIR="$HOME/.config/newmac"
NEWMAC_ANSWERS="$NEWMAC_CONFIG_DIR/answers.sh"
NEWMAC_LOG="$NEWMAC_CONFIG_DIR/newmac.log"
NEWMAC_BACKUP_DIR="$HOME/.newmac-backup/$(date +%Y%m%d-%H%M%S)"
export NEWMAC_DIR NEWMAC_CONFIG_DIR NEWMAC_ANSWERS NEWMAC_BACKUP_DIR

for file in "$NEWMAC_DIR"/lib/*.sh "$NEWMAC_DIR"/steps/*.sh; do
  # shellcheck disable=SC1090
  . "$file"
done

# ─── Steps ───────────────────────────────────────────────────────────────────
#
# The order matters: the interactive steps (GitHub login) come early, so you
# can walk away while the long downloads (Xcode, iOS runtime) finish.

ALL_STEPS=(
  homebrew packages git ssh shell iterm
  java node python intellij browsers macos
  xcode claude projects
)

step_description() {
  case "$1" in
    homebrew) echo "Xcode Command Line Tools + Homebrew" ;;
    packages) echo "CLI tools, apps and fonts from packages/*.Brewfile" ;;
    git) echo "git user/email, GitHub CLI credential helper" ;;
    ssh) echo "SSH keys per GitHub account, ~/.ssh/config, upload keys with gh" ;;
    shell) echo "oh-my-zsh, plugins, theme, dotfiles (symlinked from this repo)" ;;
    iterm) echo "iTerm2 profile: font, color scheme, default dir" ;;
    java) echo "SDKMAN + latest Temurin JDK, Maven, Gradle" ;;
    node) echo "nvm + latest Node LTS, yarn, pnpm" ;;
    python) echo "Homebrew Python, pipx, uv" ;;
    intellij) echo "IntelliJ plugins (Material Theme UI, Atom Material Icons, Prolog) + settings" ;;
    browsers) echo "Adblock Plus for Chrome and Firefox" ;;
    macos) echo "trackpad, scrolling, key repeat, keyboard languages, computer name" ;;
    xcode) echo "Xcode, TestFlight, Developer app, license, latest iOS platform" ;;
    claude) echo "Claude Code CLI (native installer)" ;;
    projects) echo "create the projects directory" ;;
  esac
}

list_steps() {
  echo "Steps (in the order init runs them):"
  local step
  for step in "${ALL_STEPS[@]}"; do
    printf '  %-9s %s\n' "$step" "$(step_description "$step")"
  done
}

FAILED_STEPS=()

run_step() {
  local step=$1
  if ! type "step_$step" >/dev/null 2>&1; then
    err "Unknown step: $step"
    list_steps
    return 1
  fi

  header "$step — $(step_description "$step")"
  load_tool_env # pick up whatever earlier steps installed

  if "step_$step"; then
    ok "$step done"
  else
    err "$step failed (continuing). Re-run later with: newmac $step"
    FAILED_STEPS+=("$step")
  fi
}

# ─── Environment ─────────────────────────────────────────────────────────────

load_tool_env() {
  local brew
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$brew" ] && eval "$("$brew" shellenv)" && break
  done
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
  esac
  export PATH
}

# Ask for the password once, then keep sudo alive until newmac exits.
keep_sudo_alive() {
  [ -n "${SUDO_KEEPALIVE_PID:-}" ] && return 0
  info "Some steps need administrator rights. Enter your Mac password once:"
  sudo -v </dev/tty || die "sudo is required."

  while kill -0 "$$" 2>/dev/null; do
    sudo -n true
    sleep 50
  done >/dev/null 2>&1 &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
}

# Copy everything printed from here on into the log file.
start_logging() {
  mkdir -p "$NEWMAC_CONFIG_DIR"
  exec > >(tee -a "$NEWMAC_LOG") 2>&1
}

# ─── Output ──────────────────────────────────────────────────────────────────

usage() {
  sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
  echo
  list_steps
}

print_summary() {
  header "Summary"
  if [ ${#FAILED_STEPS[@]} -gt 0 ]; then
    warn "These steps failed: ${FAILED_STEPS[*]}"
    warn "Fix the cause shown above, then run: newmac ${FAILED_STEPS[*]}"
  else
    ok "Everything finished."
  fi

  cat <<EOF

  Next:
   • Log out and back in (or restart) so trackpad, keyboard and language
     settings take full effect.
   • Open iTerm2 — your new profile is the default.
   • Chrome will ask you to enable Adblock Plus the first time it starts.
   • Open IntelliJ IDEA once; plugins and theme are already in place.
   • Backups of anything replaced are in: $NEWMAC_BACKUP_DIR
   • Full log: $NEWMAC_LOG
EOF
}

# ─── Main ────────────────────────────────────────────────────────────────────

main() {
  local command=${1:-help}

  case "$command" in
    help | -h | --help)
      usage
      return 0
      ;;
    steps | list)
      list_steps
      return 0
      ;;
  esac

  [ "$(uname -s)" = Darwin ] || die "newmac only runs on macOS."
  start_logging

  case "$command" in
    init | --init)
      configure_interactive
      keep_sudo_alive
      local step
      for step in "${ALL_STEPS[@]}"; do run_step "$step"; done
      print_summary
      ;;
    configure | --configure)
      configure_interactive
      ;;
    capture)
      capture_current_settings
      ;;
    update)
      git -C "$NEWMAC_DIR" pull --ff-only
      load_tool_env
      have brew && brew update && brew upgrade
      ;;
    *)
      load_answers_or_configure
      keep_sudo_alive
      local step
      for step in "$@"; do run_step "$step"; done
      if [ ${#FAILED_STEPS[@]} -gt 0 ]; then
        print_summary
        return 1
      fi
      ;;
  esac
}

main "$@"
