# Command-line basics. Installed first: later steps need git, gh, jq, mas, python.
brew "git"
brew "gh"
brew "jq"
brew "mas"          # Mac App Store CLI (Xcode, TestFlight, Developer)
brew "wget"
brew "tree"
brew "vim"
brew "bash"         # modern bash 5 (macOS ships 3.2)
brew "zsh"
brew "python"       # latest Python 3
brew "pipx"
brew "uv"
brew "swi-prolog"   # Prolog (`swipl`)
